// Cloudflare Worker that archives shared bike and scooter availability (GBFS) every 10 minutes.
// Separate from the bus collector so a failure in one cannot stop the other.
// Deploy with `npx wrangler deploy -c wrangler.gbfs.jsonc`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aviary-gbfs-collector",
  "main": "worker/gbfs.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "aviary.herebox.org/gbfs/*", "zone_name": "herebox.org" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "aviary-vermont-speeds-bucket" }],
  "observability": { "enabled": true }
}
